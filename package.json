{
  "name": "atlas-reader",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "pnpm --filter @atlas/desktop build",
    "contracts:check": "bash scripts/check-contracts.sh",
    "contracts:generate": "$HOME/.cargo/bin/cargo test -p atlas-domain export_bindings",
    "dev": "pnpm --filter @atlas/desktop dev",
    "format": "prettier --write . && $HOME/.cargo/bin/cargo fmt --all",
    "format:check": "prettier --check . && $HOME/.cargo/bin/cargo fmt --all -- --check",
    "lint": "eslint . --max-warnings=0",
    "rust:check": "$HOME/.cargo/bin/cargo check --workspace",
    "rust:lint": "$HOME/.cargo/bin/cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "$HOME/.cargo/bin/cargo test --workspace",
    "tauri": "pnpm --filter @atlas/desktop tauri",
    "tauri:build": "pnpm --filter @atlas/desktop tauri build --bundles app",
    "tauri:dev": "pnpm --filter @atlas/desktop tauri dev",
    "test": "pnpm --filter @atlas/desktop test",
    "typecheck": "pnpm --filter @atlas/desktop typecheck",
    "validate": "pnpm format:check && pnpm contracts:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm rust:lint && pnpm rust:test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.65.0"
  }
}
